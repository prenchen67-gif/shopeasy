PORT=4000
# Use a strong random value for JWT_SECRET in production. Do NOT commit real secrets to the repo.
JWT_SECRET=change_this_to_a_strong_secret
ADMIN_USERNAME=admin
# Set a real admin password via your deployment platform's environment variables (do NOT commit it here)
ADMIN_PASSWORD=change_this_to_a_strong_password
DB_FILE=./shopeasy.db
# Set this to the frontend origin (protocol + host) to enable CORS for browser requests, e.g.:
# CLIENT_ORIGIN=https://your-frontend.example
# For local testing you can set: CLIENT_ORIGIN=http://localhost:5000
CLIENT_ORIGIN=
